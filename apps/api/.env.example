# GODMODE API local config (placeholders only - never commit real secrets)
DATABASE_URL=sqlite:///./godmode.db
# DATABASE_URL=postgresql+psycopg://godmode:godmode@localhost:5432/godmode
REDIS_URL=redis://localhost:6379/0
GODMODE_REQUIRE_REDIS=0
JWT_SECRET=change-me-to-a-long-random-secret-32+
GODMODE_REQUIRE_JWT_SECRET=0
GODMODE_MOCK_LLM=1
GODMODE_ADMIN_EMAIL=admin@godmode.local
GODMODE_ADMIN_PASSWORD=change-me
# Alias (one release): SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD also accepted by seed
# SEED_ADMIN_EMAIL=admin@godmode.local
# SEED_ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000
