# Path: /workspace/godmode/repo/.env.example
# What: env template with placeholders only. Copy to .env; never commit .env.
# GODMODE local. Generate JWT: openssl rand -hex 32

# Environment: development | production
# production/staging also refuses the built-in API dev JWT default.
GODMODE_ENV=development

# Auth
# REQUIRED: JWT_SECRET must be at least 32 characters (PyJWT HS256 / InsecureKeyLengthWarning).
JWT_SECRET=local-dev-only-replace-with-openssl-rand-hex-32
# Comma-separated explicit allowlist. "*" is ignored by the API.
CORS_ORIGINS=http://localhost:3010

# Postgres (compose service)
POSTGRES_USER=godmode
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=godmode
# Compose sets DATABASE_URL for the api container; shown for host runs.
DATABASE_URL=postgresql://godmode:change-me-local-db-password@postgres:5432/godmode

# Redis (compose service)
REDIS_URL=redis://redis:6379/0

# Seed admin (DEV DEFAULTS; change password after first login)
# Prefer GODMODE_ADMIN_*; SEED_ADMIN_* kept as alias for one release.
GODMODE_ADMIN_EMAIL=admin@godmode.local
GODMODE_ADMIN_PASSWORD=change-me-admin-password
SEED_ADMIN_EMAIL=admin@godmode.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# LLM: 1 = mock (no external calls/keys)
GODMODE_MOCK_LLM=1

# Web -> API URL as seen by the browser
NEXT_PUBLIC_API_URL=http://localhost:8010
